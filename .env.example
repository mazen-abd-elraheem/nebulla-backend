# ══════════════════════════════════════════════════════
#  Nebula Backend — environment configuration
#  Copy to .env and fill in your values
# ══════════════════════════════════════════════════════

# ── Project ────────────────────────────────────────────
PROJECT_NAME="Nebula Backend"
VERSION="1.0.0"
DEBUG=false

# ── Security ───────────────────────────────────────────
# This code is burned into the Flutter apps AND the ESP32 firmware.
# Change it before first use. Keep it secret on your local network.
PAIRING_SECRET="nebula-2026-secret"
MAX_COMMANDS_PER_SECOND=20

# ── Database ───────────────────────────────────────────
# SQLite (default — zero setup, fine for a 7-person team on LAN)
DATABASE_URL="sqlite+aiosqlite:///./nebula.db"

# PostgreSQL (when you need concurrent writers):
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost/nebula"

# ── AI Provider Selection ──────────────────────────────
# STT:  qwencleo | whisper | nemotron
STT_PROVIDER=qwencleo

# TTS:  voicetut | xtts | ar_eg_free
TTS_PROVIDER=xtts

# LLM:  local | openai | anthropic
LLM_PROVIDER=local

# ── LLM Settings ───────────────────────────────────────
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434   # Ollama default
LLM_API_KEY=                          # Only needed for openai / anthropic
LLM_STREAM=true

# ── STT Model Paths ────────────────────────────────────
QWENCLEO_MODEL_PATH=models/qwencleo-asr
QWENCLEO_DEVICE=cuda                  # cuda | cpu

# ── TTS / Voice Clone ──────────────────────────────────
VOICETUT_MODEL_PATH=models/voicetut-tts
VOICETUT_DEVICE=cuda
OMNIVOICE_BASE_PATH=models/omnivoice
TTS_MAX_NEW_TOKENS=200

# ── XTTS v2 Voice Clone ────────────────────────────────
# XTTS v2 downloads its model automatically on first use (~2 GB).
# No extra config needed. Reference WAV is uploaded via /api/v1/voice-clone/upload/

# ── Vision (UniFace) ───────────────────────────────────
# scrfd | retinaface | yolo_face  (scrfd is fastest for CPU)
UNIFACE_MODEL=scrfd
UNIFACE_DEVICE=cpu                    # cpu | cuda
CAMERA_FPS=10
CAMERA_WIDTH=320
CAMERA_HEIGHT=240

# ── Memory / RAG ───────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
MEMORY_TOP_K=5

# ── Motion Guard Safety Limits ─────────────────────────
SERVO_MIN_ANGLE=0
SERVO_MAX_ANGLE=180
SERVO_MAX_SPEED_MS=2000
MOTOR_MAX_SPEED=255

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/nebula.log
